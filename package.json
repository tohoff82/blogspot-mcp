{
  "name": "blogspot-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Draft-only Blogger MCP server",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "auth": "node --env-file-if-exists=.env dist/auth/bootstrap.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "google-auth-library": "^11.1.0",
    "parse5": "^8.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
